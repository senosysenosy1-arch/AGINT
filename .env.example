# انسخ الملف ده باسم .env واملأ القيم الحقيقية بتاعتك
# لا ترفع ملف .env نفسه على GitHub أبدًا (متضاف أصلاً في .gitignore)

# مفتاح Anthropic API — من console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# بيانات الاتصال بقاعدة بيانات MySQL
# لو هتستخدم قاعدة بيانات هوستنجر (Remote MySQL): DB_HOST هيبقى IP الاستضافة
# بتاعتك (مش localhost)، والقيم التانية من hPanel → Databases → MySQL Databases
# لو هتستخدم Aiven بدلها (مجاني، من غير كارت ائتمان): هتلاقي القيم دي في لوحة تحكم الخدمة
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_assistant

# هوستنجر عادة من غير SSL على قواعد البيانات المشتركة، فسيبها false.
# Aiven غالبًا محتاج SSL، فحطها true لو بتستخدمه.
DB_SSL=false
